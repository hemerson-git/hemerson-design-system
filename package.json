{
  "name": "@hemerson/design-system",
  "version": "0.5.0",
  "description": "Liquid-glass design system: tokens, styles and React components for Hemerson's projects.",
  "license": "MIT",
  "author": "Hemerson Oliveira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemerson-git/hemerson-design-system.git"
  },
  "homepage": "https://github.com/hemerson-git/hemerson-design-system#readme",
  "bugs": {
    "url": "https://github.com/hemerson-git/hemerson-design-system/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "liquid-glass",
    "glassmorphism",
    "storybook",
    "design-tokens",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./glass": {
      "types": "./dist/glass/index.d.ts",
      "import": "./dist/glass.js"
    },
    "./appearance": {
      "types": "./dist/appearance/index.d.ts",
      "import": "./dist/appearance.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && storybook dev -p 6006",
    "build": "npm run tokens && vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/build-styles.mjs",
    "build-storybook": "npm run tokens && storybook build",
    "test": "npm run tokens && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepare": "husky",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:types",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "test:types": "tsc -p tsconfig.type-tests.json"
  },
  "peerDependencies": {
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
